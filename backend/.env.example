# Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Modelo multimodal (precisa aceitar imagem)
OPENAI_MODEL=gpt-5-mini
# low | medium | high  (deixe vazio para modelos sem raciocínio, ex.: gpt-4.1)
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=32000

# Preço do modelo em US$ por 1M de tokens — preencha com os valores de https://openai.com/api/pricing
PRICE_INPUT_PER_1M=0.25
PRICE_OUTPUT_PER_1M=2.00

# Guardrails
PRICE_MIN=1
PRICE_MAX=1500
REVIEW_THRESHOLD=0.85
